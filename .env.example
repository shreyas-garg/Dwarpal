# Copy to .env and fill in. Never commit .env.

# Upstream LLM (any OpenAI-compatible endpoint). Default: Gemini's compatibility layer.
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UPSTREAM_API_KEY=your-gemini-api-key
# gemini-2.5-flash answers new API keys with 404 "no longer available to new users" (Oct 2026).
UPSTREAM_MODEL=gemini-3.5-flash-lite
OVERRIDE_MODEL=true

# Policies
POLICY_DIR=policies
ENABLED_POLICIES=all

# Comma-separated keys clients must send as "Authorization: Bearer <key>". Empty = no auth.
API_KEYS=

EXPOSE_TRACE=true

# PR-06: guard scheduling (tiered | sequential | parallel) and the decision cache size (0 = off).
# The faithfulness judge and the schema repair reuse UPSTREAM_BASE_URL / UPSTREAM_API_KEY.
PIPELINE_STRATEGY=tiered
GUARD_CACHE_SIZE=2048
# Requests per minute for those guard LLM calls; 0 = unpaced. On Gemini's free tier set 5.
GUARD_LLM_RPM=0

# PR-07: telemetry. Every request is logged to REQUEST_DB (SQLite) with per-guard times, cost
# and added latency; prompts are stored as a SHA-256 unless LOG_PROMPTS=true.
REQUEST_DB=data/requests.db
LOG_PROMPTS=false
# Needed by GET /v1/dwarpal/stats and /v1/dwarpal/requests (send it as X-Admin-Token) and by
# the dashboard (make dashboard). Empty = those endpoints are off. Pick any long random string.
ADMIN_TOKEN=
# Optional: Langfuse traces (cloud.langfuse.com, free tier). Off unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
